{
	"name": "rozenite-growthbook-plugin",
	"version": "0.6.0",
	"description": "Rozenite DevTools plugin for GrowthBook feature flags and experiments",
	"keywords": [
		"devtools",
		"experiments",
		"feature-flags",
		"growthbook",
		"react-native",
		"rozenite"
	],
	"homepage": "https://github.com/valeriobelli/rozenite-growthbook-plugin",
	"bugs": {
		"url": "https://github.com/valeriobelli/rozenite-growthbook-plugin/issues"
	},
	"license": "MIT",
	"author": "Valerio Belli",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/valeriobelli/rozenite-growthbook-plugin.git"
	},
	"files": [
		"dist",
		"sdk.ts",
		"src/shared",
		"!src/shared/**/*.test.ts"
	],
	"main": "./dist/react-native/cjs/react-native.js",
	"module": "./dist/react-native/react-native.js",
	"types": "./dist/react-native/react-native.d.ts",
	"exports": {
		".": {
			"types": "./dist/react-native/react-native.d.ts",
			"import": "./dist/react-native/react-native.js",
			"require": "./dist/react-native/cjs/react-native.js"
		},
		"./package.json": "./package.json",
		"./sdk": {
			"development": "./sdk.ts",
			"types": "./dist/sdk/sdk.d.ts",
			"default": "./dist/sdk/sdk.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "rozenite build",
		"dev": "rozenite dev",
		"fmt": "oxfmt ./src ./sdk.ts",
		"lint": "oxlint -c ../../.oxlintrc.json ./src ./sdk.ts",
		"test": "vitest --run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@rozenite/agent-bridge": "catalog:",
		"@rozenite/agent-shared": "catalog:",
		"@rozenite/plugin-bridge": "catalog:",
		"@tanstack/query-async-storage-persister": "^5.0.0",
		"@tanstack/react-query": "^5.0.0",
		"@tanstack/react-query-persist-client": "^5.0.0",
		"arktype": "^2.0.0",
		"jotai": "^2.0.0",
		"react-error-boundary": "^6.0.0",
		"react-select": "^5.0.0"
	},
	"devDependencies": {
		"@rozenite/testing": "catalog:",
		"@rozenite/vite-plugin": "catalog:",
		"@testing-library/react": "^16.0.0",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"happy-dom": "^20.0.0",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-native": "~0.86.0",
		"react-native-web": "^0.21.2",
		"rozenite": "catalog:",
		"tailwindcss": "4.2.2",
		"vite": "^7.3.1",
		"vitest": "^5.0.0"
	},
	"peerDependencies": {
		"@growthbook/growthbook": "^1.0.0",
		"react": "*",
		"react-native": "*"
	}
}
